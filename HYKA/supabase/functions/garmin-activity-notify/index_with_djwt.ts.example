// ============================================================================
// Example: garmin-activity-notify with djwt for APNs JWT signing
// ============================================================================
// This is an example showing how to implement JWT signing using djwt
// Copy the generateAPNsToken function to your actual index.ts file
// ============================================================================

import { create, getNumericDate } from "https://deno.land/x/djwt@v2.8/mod.ts"

/**
 * Generate JWT token for APNs authentication using djwt
 */
async function generateAPNsToken(): Promise<string> {
  if (!APNS_KEY_ID || !APNS_TEAM_ID) {
    throw new Error("APNS_KEY_ID and APNS_TEAM_ID must be set in environment variables")
  }
  
  // Load key content
  let keyContent: string
  if (APNS_KEY_PATH) {
    try {
      keyContent = await Deno.readTextFile(APNS_KEY_PATH)
    } catch (error) {
      throw new Error(`Failed to read APNs key file: ${error.message}`)
    }
  } else if (Deno.env.get('APNS_KEY_CONTENT')) {
    keyContent = Deno.env.get('APNS_KEY_CONTENT')!
  } else {
    throw new Error("Either APNS_KEY_PATH or APNS_KEY_CONTENT must be set")
  }
  
  // Create JWT header
  const header = {
    alg: "ES256",
    kid: APNS_KEY_ID
  }
  
  // Create JWT payload
  const payload = {
    iss: APNS_TEAM_ID,
    iat: getNumericDate(new Date())
  }
  
  // Sign JWT with ES256
  try {
    const token = await create(header, payload, keyContent)
    return token
  } catch (error) {
    throw new Error(`Failed to create APNs JWT: ${error.message}`)
  }
}

